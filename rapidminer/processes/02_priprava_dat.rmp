        <list key="function_descriptions">
          <parameter key="is_transfer" value="if(type==&quot;TRANSFER&quot;,1,0)"/>
          <parameter key="hour" value="step % 24"/>
          <parameter key="amount_log" value="ln(amount+1)"/>
          <parameter key="errorBalanceOrig" value="newbalanceOrig + amount - oldbalanceOrg"/>
          <parameter key="errorBalanceDest" value="oldbalanceDest + amount - newbalanceDest"/>
          <parameter key="drains_account" value="if(abs(amount - oldbalanceOrg) &lt; 0.01,1,0)"/>
          <parameter key="dest_zero_balances" value="if(oldbalanceDest==0 &amp;&amp; newbalanceDest==0,1,0)"/>
        </list>
        <parameter key="keep_all" value="true"/>
